CONFIG_SERVER_URL=http://config-server:8888
CONFIG_SERVER_SEARCH_LOCATIONS=file:/config-repo/
DISCOVERY_SERVER_URL=http://discovery-server:8761/eureka/

CATALOG_DB_URL=jdbc:postgresql://catalog-service-db:5432/catalog
CATALOG_DB_USERNAME=catalog
CATALOG_DB_PASSWORD=catalog
CATALOG_DB_PORT=5432

INVENTORY_DB_URL=jdbc:postgresql://inventory-service-db:5432/inventory
INVENTORY_DB_USERNAME=inventory
INVENTORY_DB_PASSWORD=inventory
INVENTORY_DB_PORT=5433

ORDER_DB_URL=jdbc:postgresql://order-service-db:5432/orders
ORDER_DB_USERNAME=orders
ORDER_DB_PASSWORD=orders
ORDER_DB_PORT=5434

CUSTOMER_DB_URL=jdbc:postgresql://customer-service-db:5432/customer
CUSTOMER_DB_USERNAME=customer
CUSTOMER_DB_PASSWORD=customer
CUSTOMER_DB_PORT=5436

KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_PORT=9094
KAFKA_NODE_ID=1
KAFKA_PROCESS_ROLES=broker,controller
KAFKA_LISTENERS=INTERNAL://0.0.0.0:9092,EXTERNAL://0.0.0.0:9094,CONTROLLER://0.0.0.0:9093
KAFKA_ADVERTISED_LISTENERS=INTERNAL://kafka:9092,EXTERNAL://localhost:9094
KAFKA_CONTROLLER_LISTENER_NAMES=CONTROLLER
KAFKA_LISTENER_SECURITY_PROTOCOL_MAP=CONTROLLER:PLAINTEXT,INTERNAL:PLAINTEXT,EXTERNAL:PLAINTEXT
KAFKA_INTER_BROKER_LISTENER_NAME=INTERNAL
KAFKA_CONTROLLER_QUORUM_VOTERS=1@kafka:9093
KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=1
KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR=1
KAFKA_TRANSACTION_STATE_LOG_MIN_ISR=1
KAFKA_GROUP_INITIAL_REBALANCE_DELAY_MS=0
KAFKA_AUTO_CREATE_TOPICS_ENABLE=false
KAFKA_LOG_DIRS=/var/lib/kafka/data

KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_PORT=9090
KEYCLOAK_JWK_SET_URI=http://keycloak:9090/realms/bazaar/protocol/openid-connect/certs
KEYCLOAK_DB_URL=jdbc:postgresql://keycloak-db:5432/keycloak
KEYCLOAK_DB_USERNAME=keycloak
KEYCLOAK_DB_PASSWORD=keycloak
KEYCLOAK_DB_PORT=5435
