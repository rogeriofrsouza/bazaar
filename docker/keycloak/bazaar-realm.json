{
  "realm": "bazaar",
  "enabled": true,
  "roles": {
    "realm": [
      {
        "name": "customer",
        "description": "Shops the catalog and places orders"
      },
      {
        "name": "admin",
        "description": "Manages the catalog, inventory and orders"
      }
    ]
  },
  "clients": [
    {
      "clientId": "bazaar-web",
      "name": "Bazaar web",
      "description": "First-party frontends and the gateway's Swagger UI",
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://localhost:8080/*"
      ],
      "webOrigins": [
        "+"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      }
    }
  ],
  "users": [
    {
      "username": "customer",
      "enabled": true,
      "email": "customer@example.com",
      "emailVerified": true,
      "firstName": "Super",
      "lastName": "Customer",
      "credentials": [
        {
          "type": "password",
          "value": "customer",
          "temporary": false
        }
      ],
      "realmRoles": [
        "customer"
      ]
    },
    {
      "username": "admin",
      "enabled": true,
      "email": "admin@example.com",
      "emailVerified": true,
      "firstName": "Super",
      "lastName": "Admin",
      "credentials": [
        {
          "type": "password",
          "value": "admin",
          "temporary": false
        }
      ],
      "realmRoles": [
        "admin"
      ]
    }
  ]
}
